# Copy to .env.local for local development. Provider keys are optional: a
# provider without one is shown greyed out. See CLAUDE.md "Environment variables".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional, defaults to http://localhost:1234/v1
LMSTUDIO_BASE_URL=
# Optional, defaults to https://german-metrical-psalter.vercel.app
NEXT_PUBLIC_SITE_URL=
# Job store, required on Vercel and Trigger.dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# On Vercel, so /api/generate and cancel can reach Trigger.dev
TRIGGER_SECRET_KEY=
